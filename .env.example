# Copy this file to .env and fill in your Cisco Secure Access API credentials.
# Get a key pair at: Admin → API Keys → Add (scopes appropriate to the example).
# DO NOT commit the populated .env — it is gitignored.

CLIENT_ID=your-client-id-here
CLIENT_SECRET=your-client-secret-here

# The following are written automatically by examples/access_token.py
# after the first successful token fetch — leave blank or omit.
ACCESS_TOKEN=
EXPIRES_IN=
TIMESTAMP=
